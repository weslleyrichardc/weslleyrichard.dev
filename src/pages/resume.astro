---
import Section from '@/components/Section.astro'
import ExperienceItem from '@/components/ExperienceItem.astro'
import SkillBadge from '@/components/SkillBadge.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile, availability, experience, education, skills } from '@/data/resume'
---

<PageLayout meta={{ title: 'Resume' }}>
	<div class='page resume-page'>
		<PageHeader
			title='Weslley Richard'
			description='Backend Software Engineer · PHP / Laravel / Symfony — Tbilisi, Georgia (UTC+4)'
		>
			<p class='text-muted-foreground print:hidden'>{availability}</p>
			<button class='button-outline print:hidden' type='button' onclick='window.print()'>
				Print / Save as PDF
			</button>
		</PageHeader>

		<Section title='Profile'>
			<p class='text-foreground'>{profile}</p>
		</Section>

		<Section title='Experience'>
			<ul class='space-y-4 text-muted-foreground'>
				{experience.map((item) => <ExperienceItem {...item} />)}
			</ul>
		</Section>

		<Section title='Education'>
			<ul class='space-y-2 text-foreground'>
				{
					education.map((item) => (
						<li>
							<strong>{item.school}</strong> — {item.degree} — {item.period}
						</li>
					))
				}
			</ul>
		</Section>

		<Section title='Technical Stack'>
			<ul class='space-y-2 text-foreground'>
				{skills.map((item) => <SkillBadge {...item} />)}
			</ul>
		</Section>
	</div>
</PageLayout>
