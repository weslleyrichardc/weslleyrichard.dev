---
import Label from '../components/Label.astro'
import Section from '../components/Section.astro'
import Icon from '../components/Icon.astro'
import PageLayout from '../layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'Home' }}>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-3xl font-bold'>Weslley Richard</h1>
				<p class='text-lg text-muted-foreground'>
					Backend Software Engineer · PHP / Laravel / Symfony
				</p>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='Tbilisi, Georgia'>
						<Icon name='location' slot='icon' />
					</Label>
					<Label
						title='Connect on Linkedin'
						as='a'
						href='https://www.linkedin.com/in/weslleyrichardc'
						target='_blank'
					>
						<Icon name='linkedin' slot='icon' class='h-5 w-5 text-foreground/75' />
					</Label>
				</div>
				<p class='text-center text-muted-foreground'>
					Open to remote full-stack/backend roles (PHP/Laravel preferred); freelance, consulting,
					and part-time welcome.
				</p>
			</div>
		</section>

		<Section title='About'>
			<p class='text-foreground'>
				I am a Software Engineer with a product mindset, focused on delivering solutions that go
				beyond code to address real business needs. My experience spans from agile startups to
				large-scale enterprise environments. I specialize in architecting scalable microservices
				using PHP (Symfony/Laravel), AWS, and Docker. I actively mentor teams and foster
				collaboration to ensure projects move seamlessly from concept to execution.
			</p>
		</Section>
	</div>
</PageLayout>
