---
export interface Props {
	title: string
	company: string
	companyUrl: string
	period: string
	description: string
	employmentType?: string
}

const { title, company, companyUrl, period, description, employmentType } = Astro.props
---

<li class='flex flex-col gap-y-2'>
	<div>
		<strong class='text-foreground'>{title}</strong> at{' '}
		<a href={companyUrl} target='_blank' rel='noopener noreferrer' class='hover:underline'>
			{company}
		</a>{' '}
		({period}){employmentType && <span class='text-muted-foreground'> · {employmentType}</span>}
	</div>
	<p class='text-foreground'>{description}</p>
</li>
