---
import Icon from './Icon.astro'
import { siteConfig } from '@/site-config'

export interface Props {
	name: 'linkedin'
	class?: string
}

const {
	name,
	class:
		className = 'inline-block text-muted-foreground transition-all hover:text-muted-foreground/75'
} = Astro.props

const href = siteConfig.socialLinks[name]
---

<a class={className} href={href} target='_blank' rel='noopener noreferrer'>
	<Icon name={name} class='h-4 w-4 flex-shrink-0' />
</a>
