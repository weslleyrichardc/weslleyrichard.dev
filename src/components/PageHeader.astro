---
import { cn } from '@/lib/utils'

interface Props {
	title: string
	description?: string
	align?: 'left' | 'center'
	class?: string
}

const { title, description, align = 'left', class: className } = Astro.props
---

<header class={cn('page-header', align === 'center' && 'items-center text-center', className)}>
	<h1 class='page-title'>{title}</h1>
	{description && <p class='page-lede'>{description}</p>}
	<slot />
</header>
