---
import Label from '../components/Label.astro'
import Section from '../components/Section.astro'
import Icon from '../components/Icon.astro'
import PageHeader from '@/components/PageHeader.astro'
import PageLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '@/site-config'
import { profile, availability } from '@/data/resume'
---

<PageLayout meta={{ title: 'Home' }}>
	<div class='page'>
		<PageHeader
			title='Weslley Richard'
			description='Backend Software Engineer · PHP / Laravel / Symfony'
			align='center'
		>
			<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
				<Label title='Tbilisi, Georgia'>
					<Icon name='location' slot='icon' />
				</Label>
				<Label
					title='Connect on LinkedIn'
					as='a'
					href={siteConfig.socialLinks.linkedin}
					target='_blank'
					rel='noopener noreferrer'
				>
					<Icon name='linkedin' slot='icon' class='h-5 w-5 text-foreground/75' />
				</Label>
			</div>
			<p class='text-center text-muted-foreground'>{availability}</p>
		</PageHeader>

		<Section title='About'>
			<p class='text-foreground'>{profile}</p>
		</Section>

		<Section title='Currently'>
			<ul class='list-inside list-disc space-y-1 text-muted-foreground'>
				<li>
					Traveling and working remotely: Europe and Georgia so far, Asia next — going full nomad.
				</li>
				<li>
					Open to remote roles (full-stack/backend, PHP/Laravel preferred), freelance, consulting,
					part-time.
				</li>
				<li>Based in Tbilisi, Georgia (UTC+4).</li>
			</ul>
		</Section>
	</div>
</PageLayout>
