---
import ThemeToggle from '../../components/ThemeToggle.astro'
---

<header class='mb-12 flex w-full flex-wrap pb-3 text-sm sm:flex-nowrap sm:justify-start'>
	<nav
		class='relative mx-auto flex w-full items-center justify-between sm:flex sm:items-center'
		aria-label='global'
	>
		<a class='flex-none text-xl font-semibold' href='/'>Weslley Richard</a>

		<button
			class='cursor-pointer rounded px-2 py-1 text-sm hover:bg-accent'
			title='Press Ctrl+K to open command palette'
			onclick="document.dispatchEvent(new Event('open-command-palette'))"
		>
			<kbd
				class='pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded-sm bg-muted px-1 font-sans text-xs font-medium text-muted-foreground'
			>
				Ctrl+K
			</kbd>
		</button>

		<div class='flex flex-row items-center justify-center gap-x-5 sm:gap-x-7'>
			<a href='/about' class='flex-none text-[1.05rem] font-medium hover:text-foreground/75'
				>About Me
			</a>

			<ThemeToggle />
		</div>
	</nav>
</header>
