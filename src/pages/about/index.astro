---
import Button from '@/components/Button.astro'
import Card from '@/components/Card.astro'
import Section from '@/components/Section.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'About Me' }}>
	<div class='w-full'>
		<Button title='Back' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-10'>
			<Section title='Experience'>
				<Card
					heading='Backend Software Engineer | PHP - Symfony'
					subheading='Printi'
					date='Apr 2023 - Present'
					altText='Printi'
					imageClass='h-12 w-auto md:-left-16'
					as='a'
					href='https://www.linkedin.com/in/weslleyrichardc'
				/>
				<Card
					heading='Backend Software Engineer | PHP - Symfony'
					subheading='Datum TI'
					date='Sep 2022 - Apr 2023'
					altText='Datum TI'
					imageClass='h-12 w-auto md:-left-16'
					as='a'
					href='https://www.linkedin.com/in/weslleyrichardc'
				/>
				<Card
					heading='Full Stack Software Engineer | PHP - Laravel | Alpine JS - React'
					subheading='Cloudfox'
					date='Apr 2021 - Jun 2022'
					altText='Cloudfox'
					imageClass='h-12 w-auto md:-left-16'
					as='a'
					href='https://www.linkedin.com/in/weslleyrichardc'
				/>
				<Card
					heading='Full Stack Software Engineer | PHP - Laravel | Vue'
					subheading='KBR TEC - Web & Software'
					date='Oct 2019 - Mar 2021'
					altText='KBR TEC - Web & Software'
					imageClass='h-12 w-auto md:-left-16'
					as='a'
					href='https://www.linkedin.com/in/weslleyrichardc'
				/>
			</Section>
			<Section title='Technical Toolkit'>
				<Card
					heading='PHP (Laravel, Symfony)'
					subheading='Backend'
					altText='Backend - PHP (Laravel, Symfony)'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='JavaScript (React, Vue, AlpineJS)'
					subheading='Frontend'
					altText='Frontend - JavaScript (React, Vue, AlpineJS)'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='Docker'
					subheading='Cloud & Infrastructure'
					altText='Cloud & Infrastructure - Docker'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='AWS (SNS, SQS, Lambda)'
					subheading='Cloud & Infrastructure'
					altText='Cloud & Infrastructure - AWS (SNS, SQS, Lambda)'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='RabbitMQ'
					subheading='Messaging & Queuing'
					altText='Messaging & Queuing - RabbitMQ'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='SQL (MySQL, Oracle Database)'
					subheading='Databases'
					altText='Databases - MySQL, Oracle Database'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='NoSQL (MongoDB)'
					subheading='Databases'
					altText='Databases - NoSQL (MongoDB)'
					imageClass='h-12 w-auto md:-left-16'
				/>
				<Card
					heading='Redis'
					subheading='Databases'
					altText='Databases - Redis'
					imageClass='h-12 w-auto md:-left-16'
				/>
			</Section>
			<Section title='Certifications'>
				<Card
					as='a'
					heading='Curso de Apache Kafka'
					subheading='Full Cycle'
					date='May 2024'
					altText='Full Cycle'
					imageClass='h-11 w-auto md:-left-16'
					href='https://fullcycle.com.br/certificado/ce9f76a1-6ac1-4d03-9524-e66676d23393'
				/>
				<Card
					as='a'
					heading='Curso de Docker'
					subheading='Full Cycle'
					date='Dec 2023'
					altText='Full Cycle'
					imageClass='h-11 w-auto md:-left-16'
					href='https://fullcycle.com.br/certificado/9af5d329-0cb8-489a-bc40-02880cd826ba'
				/>
				<Card
					as='a'
					heading='Curso de Fundamentos da arquitetura de software'
					subheading='Full Cycle'
					date='Dec 2023'
					altText='Full Cycle'
					imageClass='h-11 w-auto md:-left-16'
					href='https://fullcycle.com.br/certificado/2f693e93-1f7b-4a05-8b24-481838ed2a0e'
				/>
			</Section>
		</div>
	</div>
</PageLayout>
