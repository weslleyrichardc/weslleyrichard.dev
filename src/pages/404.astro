---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
	description: 'Not found',
	title: '404'
}
---

<PageLayout meta={meta}>
	<div class='flex w-full flex-col items-center gap-y-2 py-10 text-center'>
		<h1 class='text-7xl font-bold tracking-tight sm:text-9xl'>404</h1>
		<p class='page-lede'>Oops, something went wrong.</p>
		<p class='text-foreground'>Sorry, we couldn't find your page.</p>
	</div>
</PageLayout>
