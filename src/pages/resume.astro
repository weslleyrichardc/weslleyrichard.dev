---
import Section from '@/components/Section.astro'
import ExperienceItem from '@/components/ExperienceItem.astro'
import SkillBadge from '@/components/SkillBadge.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile, experience, education, skills } from '@/data/resume'
---

<PageLayout meta={{ title: 'Resume' }}>
	<div class='resume-page flex w-full flex-col gap-y-10'>
		<header class='flex flex-col gap-y-2'>
			<h1 class='text-3xl font-bold'>Weslley Richard</h1>
			<p class='text-muted-foreground'>
				Backend Software Engineer · PHP / Laravel / Symfony — Tbilisi, Georgia (UTC+4)
			</p>
			<p class='text-muted-foreground'>
				Open to remote full-stack/backend roles (PHP/Laravel preferred) and freelance, consulting,
				and part-time welcome.
			</p>
			<button
				class='w-fit cursor-pointer rounded border border-border px-2 py-1 text-sm transition-all hover:bg-accent print:hidden'
				onclick='window.print()'
			>
				Print / Save as PDF
			</button>
		</header>

		<Section title='Profile'>
			<p class='text-foreground'>
				{profile}
			</p>
		</Section>

		<Section title='Experience'>
			<ul class='space-y-4 text-muted-foreground'>
				{experience.map((item) => <ExperienceItem {...item} />)}
			</ul>
		</Section>

		<Section title='Education'>
			<ul class='space-y-2 text-foreground'>
				{
					education.map((item) => (
						<li>
							<strong>{item.school}</strong> — {item.degree} — {item.period}
						</li>
					))
				}
			</ul>
		</Section>

		<Section title='Technical Stack'>
			<ul class='space-y-2 text-foreground'>
				{skills.map((item) => <SkillBadge {...item} />)}
			</ul>
		</Section>
	</div>
</PageLayout>
