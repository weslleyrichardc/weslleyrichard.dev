---
import Label from '../components/Label.astro'
import Section from '../components/Section.astro'
import Icon from '../components/Icon.astro'
import PageLayout from '../layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'Home' }}>
	<div class='flex w-full flex-col gap-y-10'>
		<section class='flex flex-col items-center gap-y-7'>
			<div class='flex flex-col items-center gap-y-4'>
				<h1 class='text-3xl font-bold'>Weslley Richard</h1>
				<p class='text-lg text-muted-foreground'>
					Backend Software Engineer · PHP / Laravel / Symfony
				</p>
				<div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
					<Label title='Tbilisi, Georgia'>
						<Icon name='location' slot='icon' />
					</Label>
					<Label
						title='Connect on Linkedin'
						as='a'
						href='https://www.linkedin.com/in/weslleyrichardc'
						target='_blank'
					>
						<Icon name='linkedin' slot='icon' class='h-5 w-5 text-foreground/75' />
					</Label>
				</div>
				<p class='text-center text-muted-foreground'>
					Open to remote full-stack/backend roles (PHP/Laravel preferred) and freelance, consulting,
					and part-time welcome.
				</p>
			</div>
		</section>

		<Section title='About'>
			<p class='text-foreground'>
				I'm a Software Engineer with a product mindset, focused on solutions that go beyond code to
				address real business needs. My experience spans agile startups and enterprise environments.
				I specialize in architecting scalable microservices with PHP (Laravel, Symfony), AWS, and
				Docker, and I actively mentor teams so projects move seamlessly from concept to execution.
			</p>
		</Section>

		<Section title='Currently'>
			<ul class='list-inside list-disc space-y-1 text-muted-foreground'>
				<li>
					Traveling and working remotely: Europe and Georgia so far, Asia next — going full nomad.
				</li>
				<li>
					Open to remote roles (full-stack/backend, PHP/Laravel preferred), freelance, consulting,
					part-time.
				</li>
				<li>Based in Tbilisi, Georgia (UTC+4).</li>
			</ul>
		</Section>

		<Section title='Projects'>
			<ul class='space-y-4'>
				<li class='flex flex-col gap-y-1'>
					<a
						class='text-foreground hover:underline'
						href='https://github.com/weslleyrichardc/realworld-symfony-alpine'
						target='_blank'
						rel='noopener noreferrer'
					>
						realworld-symfony-alpine
					</a>
					<p class='text-muted-foreground'>
						Full-stack Symfony and Alpine.js implementation of the RealWorld API spec, with JWT
						authentication, PostgreSQL and Docker.
					</p>
				</li>
				<li class='flex flex-col gap-y-1'>
					<a
						class='text-foreground hover:underline'
						href='https://github.com/weslleyrichardc/movie-database-api'
						target='_blank'
						rel='noopener noreferrer'
					>
						movie-database-api
					</a>
					<p class='text-muted-foreground'>
						REST API for a movie catalog, with categories, images, pagination, filters and
						token-based authentication.
					</p>
				</li>
			</ul>
		</Section>
	</div>
</PageLayout>
