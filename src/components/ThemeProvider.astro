<script is:inline>
	// The theme has exactly one owner: this script. The header button and the
	// palette only dispatch `toggle-theme`. It is wrapped in a function because
	// inline scripts re-run on view transitions, and a second top-level `const`
	// would throw.
	;(() => {
		if (window.__themeInit) return
		window.__themeInit = true

		const lightModePref = window.matchMedia('(prefers-color-scheme: light)')

		function applyTheme(newTheme) {
			if (newTheme !== 'light' && newTheme !== 'dark') {
				return console.log(
					`Invalid theme value '${newTheme}' received. Expected 'light' or 'dark'.`
				)
			}

			const isDark = newTheme === 'dark'
			document.documentElement.classList.toggle('dark', isDark)

			const toggle = document.querySelector('#toggleDarkMode')
			if (toggle) toggle.setAttribute('aria-pressed', String(isDark))

			// One tag per OS scheme keeps the no-JS default; overwrite both so
			// the manual choice wins whichever scheme the OS reports.
			document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
				meta.setAttribute('content', isDark ? '#09090b' : '#fcfcfd')
			})
		}

		// The visitor's stored choice wins; otherwise follow the OS.
		const preferredTheme = () =>
			localStorage.getItem('theme') || (lightModePref.matches ? 'light' : 'dark')

		applyTheme(preferredTheme())

		// View Transitions hook to restore theme
		document.addEventListener('astro:after-swap', () => applyTheme(preferredTheme()))

		// Runs on first load and after each transition, once the header button
		// that this script sits before exists and can take its aria state.
		document.addEventListener('astro:page-load', () => applyTheme(preferredTheme()))

		// Follow the OS only while the visitor has not chosen for themselves
		lightModePref.addEventListener('change', (e) => {
			if (!localStorage.getItem('theme')) applyTheme(e.matches ? 'light' : 'dark')
		})

		// The only place a choice is persisted.
		document.addEventListener('toggle-theme', () => {
			const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
			localStorage.setItem('theme', next)
			applyTheme(next)
		})
	})()
</script>
