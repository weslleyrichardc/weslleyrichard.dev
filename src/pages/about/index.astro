---
import Button from '@/components/Button.astro'
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import ExperienceItem from '@/components/ExperienceItem.astro'
import SkillBadge from '@/components/SkillBadge.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'About Me' }}>
	<div class='flex flex-col gap-y-10'>
		<div class='flex'>
			<Button title='Back' href='/' style='button'>
				<Icon name='back' slot='icon-before' class='h-3.5 w-3.5' />
			</Button>
		</div>

		<Section title='Experience'>
			<ul class='space-y-4 text-muted-foreground'>
				<ExperienceItem
					title='PHP Backend Software Engineer'
					company='Printi'
					companyUrl='https://www.printi.com.br'
					period='Apr 2023 – Jul 2025'
					description='Designed scalable microservices using Symfony and AWS (Lambda, SQS) to enhance system reliability. Led remote teams and mentored developers to meet sprint deadlines.'
				/>
				<ExperienceItem
					title='PHP Backend Software Engineer'
					company='Brasil TecPar (Datum TI)'
					companyUrl='https://www.brasiltecpar.com.br/'
					period='Sep 2022 – Apr 2023'
					description='Maintained critical integrations using Symfony and RabbitMQ; resolved cross-domain networking challenges.'
				/>
				<ExperienceItem
					title='PHP Software Engineer'
					company='Cloudfox'
					companyUrl='https://cloudfox.net/'
					period='Apr 2021 – Jun 2022'
					description='Co-developed an anti-fraud system that reduced chargeback costs by ~60%. Built a real-time decision dashboard using Alpine.js.'
				/>
				<ExperienceItem
					title='Software Engineer'
					company='KBR Tec'
					companyUrl='https://www.kbrtec.com.br'
					period='Oct 2019 – Mar 2021'
					description='Developed dynamic scheduling tools and internal management systems to centralize project tracking.'
				/>
			</ul>
		</Section>
		<Section title='Technical Stack'>
			<ul class='space-y-2 text-foreground'>
				<SkillBadge category='Backend' skills='PHP (Symfony, Laravel), Go, Python' />
				<SkillBadge category='Frontend' skills='JavaScript (React, Vue, Alpine.js), Tailwind CSS' />
				<SkillBadge
					category='Cloud & Infrastructure'
					skills='AWS (SNS, SQS, EC2, Lambda), Docker'
				/>
				<SkillBadge category='Messaging & Queuing' skills='RabbitMQ, Kafka' />
				<SkillBadge category='Databases' skills='MySQL, PostgreSQL, Oracle DB, MongoDB, Redis' />
				<SkillBadge category='Quality & DevOps' skills='PHPUnit, SonarQube, Jenkins, CI/CD' />
			</ul>
		</Section>
	</div>
</PageLayout>
