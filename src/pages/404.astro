---
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
	description: 'Not found',
	title: '404'
}
---

<PageLayout meta={meta}>
	<div class='flex w-full flex-col items-center gap-y-3 py-10 text-center'>
		<h1 class='text-7xl font-bold tracking-tight sm:text-9xl'>404</h1>
		<p class='page-lede'>This page doesn't exist.</p>
		<p class='text-muted-foreground'>
			The link may be broken, or the page moved. Go to the
			<a class='text-foreground underline underline-offset-4 hover:decoration-2' href='/'
				>home page</a
			>
			or <a class='text-foreground underline underline-offset-4 hover:decoration-2' href='/blog/'>
				read the blog
			</a>.
		</p>
	</div>
</PageLayout>
