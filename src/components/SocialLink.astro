---
import Icon from './Icon.astro'
import { cn } from '@/lib/utils'
import { siteConfig } from '@/site-config'

export interface Props {
	name: 'linkedin' | 'github' | 'email'
	class?: string
}

const {
	name,
	class:
		className = 'inline-flex h-6 w-6 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-foreground'
} = Astro.props

const href = siteConfig.socialLinks[name]
// A mailto in a new tab leaves an empty window behind; only external sites open one.
const external = name !== 'email'

const label = name === 'github' ? 'GitHub' : name === 'linkedin' ? 'LinkedIn' : 'Email'
---

<a
	class={cn(className)}
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	aria-label={label}
>
	<Icon name={name} class='h-4 w-4 flex-shrink-0' />
</a>
