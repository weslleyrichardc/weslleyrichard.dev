---
import SocialLink from '../../components/SocialLink.astro'
---

<footer class='mx-auto mt-24 w-full'>
	<div class='border-t border-border pt-5'>
		<div
			class='flex flex-col items-center gap-y-3 sm:flex sm:flex-row sm:items-center sm:justify-between sm:gap-y-0'
		>
			<div class='flex gap-x-4 text-sm'>
				<p class=''>
					© <span data-footer-year>2026</span> Weslley Richard. All rights reserved.
				</p>
			</div>

			<div class='flex items-center justify-between'>
				<!-- Social Brands -->
				<div class='flex items-center gap-x-4'>
					<!-- Linkedin -->
					<SocialLink name='linkedin' />
					<!-- GitHub -->
					<SocialLink name='github' />
					<!-- Email -->
					<SocialLink name='email' />
				</div>
				<!-- End Social Brands -->
			</div>
		</div>
	</div>
</footer>

<script is:inline>
	// Year is rendered client-side so it never freezes at build time.
	// Registered once; re-applied after each view transition via astro:page-load.
	if (!window.__footerYearInit) {
		window.__footerYearInit = true
		const applyYear = () => {
			document.querySelectorAll('[data-footer-year]').forEach((el) => {
				el.textContent = new Date().getFullYear().toString()
			})
		}
		document.addEventListener('astro:page-load', applyYear)
	}
</script>
