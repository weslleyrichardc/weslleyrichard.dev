---
import Button from '@/components/Button.astro'
import Section from '@/components/Section.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
---

<PageLayout meta={{ title: 'About Me' }}>
	<div class='w-full'>
		<Button title='Back' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-10'>
			<Section title='Experience'>
				<ul class='space-y-4 text-muted-foreground'>
					<li>
						<strong class='text-foreground'>PHP Backend Software Engineer</strong> at <a
							href='https://www.printi.com.br'
							target='_blank'
							class='hover:underline'>Printi</a
						> (Apr 2023 – Jul 2025)<br />
						<p class='text-foreground'>
							Designed scalable microservices using Symfony and AWS (Lambda, SQS) to enhance system
							reliability. Led remote teams and mentored developers to meet sprint deadlines.
						</p>
					</li>
					<li>
						<strong class='text-foreground'>PHP Backend Software Engineer</strong> at <a
							href='https://www.brasiltecpar.com.br/'
							target='_blank'
							class='hover:underline'>Brasil TecPar (Datum TI)</a
						> (Sep 2022 – Apr 2023)<br />
						<p class='text-foreground'>
							Maintained critical integrations using Symfony and RabbitMQ; resolved cross-domain
							networking challenges.
						</p>
					</li>
					<li>
						<strong class='text-foreground'>PHP Software Engineer</strong> at <a
							href='https://cloudfox.net/'
							target='_blank'
							class='hover:underline'>Cloudfox</a
						> (Apr 2021 – Jun 2022)<br />
						<p class='text-foreground'>
							Co-developed an anti-fraud system that reduced chargeback costs by ~60%. Built a
							real-time decision dashboard using Alpine.js.
						</p>
					</li>
					<li>
						<strong class='text-foreground'>Software Engineer</strong> at <a
							href='https://www.kbrtec.com.br'
							target='_blank'
							class='hover:underline'>KBR Tec</a
						> (Oct 2019 – Mar 2021)<br />
						<p class='text-foreground'>
							Developed dynamic scheduling tools and internal management systems to centralize
							project tracking.
						</p>
					</li>
				</ul>
			</Section>
			<Section title='Technical Stack'>
				<ul class='space-y-2 text-muted-foreground'>
					<li>
						<strong class='text-foreground'>Backend:</strong> PHP (Symfony, Laravel), Go, Python
					</li>
					<li>
						<strong class='text-foreground'>Frontend:</strong> JavaScript (React, Vue, Alpine.js), Tailwind
						CSS
					</li>
					<li>
						<strong class='text-foreground'>Cloud & Infrastructure:</strong> AWS (SNS, SQS, EC2, Lambda),
						Docker
					</li>
					<li><strong class='text-foreground'>Messaging & Queuing:</strong> RabbitMQ, Kafka</li>
					<li>
						<strong class='text-foreground'>Databases:</strong> MySQL, PostgreSQL, Oracle DB, MongoDB,
						Redis
					</li>
					<li>
						<strong class='text-foreground'>Quality & DevOps:</strong> PHPUnit, SonarQube, Jenkins, CI/CD
					</li>
				</ul>
			</Section>
		</div>
	</div>
</PageLayout>
